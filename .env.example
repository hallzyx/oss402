# OSS402 API — Stellar Testnet x402

PORT=8787

# Maintainer wallet that receives 0.05 USDC per certification run (G...)
MAINTAINER_STELLAR_ADDRESS=

# Coinbase public facilitator (default) or OpenZeppelin Relayer facilitator
X402_FACILITATOR_URL=https://www.x402.org/facilitator
# Required only for OpenZeppelin facilitator:
# X402_FACILITATOR_API_KEY=

# Agent / payer wallet secret (S...) — used by MCP client and scripts/pay-certify.ts
STELLAR_PRIVATE_KEY=

# Run conformance locally after payment (default true). Set 0 to use GitHub Actions only.
OSS402_RUN_LOCALLY=1

# Optional GitHub Actions dispatch
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=hallzyx/oss402
# OSS402_CALLBACK_URL=https://your-tunnel.example
# OSS402_CALLBACK_SECRET=change-me

# Optional Soroban attestation (after deploying contracts/oss402-attestation)
# ATTESTATION_CONTRACT_ID=
# STELLAR_IDENTITY=maintainer
# STELLAR_NETWORK=testnet

# Optional on-chain attestation tx hash once Soroban contract is deployed
# ATTESTATION_TX_HASH=
